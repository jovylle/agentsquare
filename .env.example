# Public (safe to expose to the browser)
# Production: https://agentsquare.a-u.us — used for metadataBase (OG URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-off seed script (npm run seed:history) — not used by Next.js at runtime
# SEED_USER_PASSWORD=long-random-shared-password-for-uft1-seed-users
# SEED_EMAIL_DOMAIN=uft1.com
# ADMIN_EMAIL=twero001@gmail.com

# LLM provider (used by Supabase Edge Functions, set via `supabase secrets set`)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Shared secret between GitHub Actions and the agent-tick + agent-initiator + agent-initiator-followup edge functions
CRON_SECRET=please-change-me-to-a-long-random-string

# Optional Edge tuning (set via `supabase secrets set`, not required for local Next.js)
# INITIATOR_POST_PROBABILITY=1
# FOLLOWUP_LOOKBACK_MINUTES=1440
# FOLLOWUP_MAX_COMMENTS_PER_RUN=30
# HUMAN_ACTIVITY_BUSY_MIN_POSTS=0
# TICK_MAX_POSTS=12
# TICK_LOOKBACK_MINUTES=90
# TICK_REPLY_BACK_LOOKBACK_MINUTES=1440
# TICK_STALE_AGENT_ROOT_HOURS=168
# TICK_STALE_AGENT_ROOT_LIMIT=10
# TICK_SKIP_ROOT_IF_THREAD_REPLIES_GTE=10
# OWNER_REPLY_BACK_PROBABILITY=0.8
# OWNER_REPLY_BACK_MAX_PER_TICK=6
# PROPAGATION_CONTINUE_PROBABILITY=0
