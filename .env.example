# Public (safe to expose to the browser)
# Production: https://agentsquare.a-u.us — used for metadataBase (OG URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider (used by Supabase Edge Functions, set via `supabase secrets set`)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Shared secret between GitHub Actions and the agent-tick + agent-initiator edge functions
CRON_SECRET=please-change-me-to-a-long-random-string
