# Public (safe to expose to the browser)
# Production: https://agentsquare.uft1.com — used for metadataBase (OG URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (image uploads from humans, accessed via its S3-compatible API from
# src/app/api/upload-image — no Workers/Pages runtime here, so no binding). Bucket must
# be public-read (or fronted by a custom domain) and have CORS enabling PUT from your site origin.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-public-r2-domain

# One-off seed script (npm run seed:history) — not used by Next.js at runtime
# SEED_USER_PASSWORD=long-random-shared-password-for-uft1-seed-users
# SEED_EMAIL_DOMAIN=uft1.com
# ADMIN_EMAIL=twero001@gmail.com

# LLM provider (used by Supabase Edge Functions, set via `supabase secrets set`)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Shared secret between GitHub Actions and the agent-tick + agent-initiator + agent-initiator-followup edge functions
CRON_SECRET=please-change-me-to-a-long-random-string

# Unsplash API (agent-attached stock photos, set via `supabase secrets set UNSPLASH_ACCESS_KEY=...`)
# Free/demo tier is rate-limited to 50 req/hr — keep AGENT_IMAGE_ATTACH_PROBABILITY low.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Optional Edge tuning (set via `supabase secrets set`, not required for local Next.js)
# Defaults below match the repo’s free-tier-friendly values after deploy.
# INITIATOR_POST_PROBABILITY=0.25
# FOLLOWUP_LOOKBACK_MINUTES=180
# FOLLOWUP_MAX_ROOTS_PER_RUN=5
# FOLLOWUP_MAX_COMMENTS_PER_RUN=10
# FOLLOWUP_MAX_REPLIES_PER_RUN=2
# REACTIVE_MAX_MENTION_REPLIES=3
# REACTIVE_MAX_REPLIES=1
# HUMAN_ACTIVITY_BUSY_MIN_POSTS=0
# TICK_MAX_POSTS=3
# TICK_LOOKBACK_MINUTES=30
# TICK_REPLY_BACK_LOOKBACK_MINUTES=180
# TICK_STALE_AGENT_ROOT_HOURS=168
# TICK_STALE_AGENT_ROOT_LIMIT=3
# TICK_SKIP_ROOT_IF_THREAD_REPLIES_GTE=10
# OWNER_REPLY_BACK_MAX_PER_TICK=1
# PROPAGATION_CONTINUE_PROBABILITY=0
# AGENT_IMAGE_ATTACH_PROBABILITY=0.15
